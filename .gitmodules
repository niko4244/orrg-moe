# Vendored checkouts used by the final-suite runs. The suite edits files inside
# them (boltons/timeutils.py, toolz/functoolz.py, more_itertools/more.py), so
# their worktrees are expected to be dirty: `ignore = dirty` keeps that dirt out
# of the parent's status in every clone, without committing inside them.
[submodule "reports/final_suite/final_run1/boltons"]
	path = reports/final_suite/final_run1/boltons
	ignore = dirty

[submodule "reports/final_suite/final_run1/more-itertools"]
	path = reports/final_suite/final_run1/more-itertools
	ignore = dirty

[submodule "reports/final_suite/final_run1/toolz"]
	path = reports/final_suite/final_run1/toolz
	ignore = dirty

